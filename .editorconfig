# EditorConfig for LBM-Rust — https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,typ}]
indent_size = 2

# Markdown 中两个行尾空格表示硬换行，不能修剪
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# 生成产物由示例程序输出，check-generated 按字节比对，不做规范化
[book/assets/**/*.svg]
insert_final_newline = false
trim_trailing_whitespace = false
